---
import Layout from "@layouts/Layout.astro";
import MetaHead from "@components/general/MetaHead.astro";
import { studiesData } from "../data/studies";

const { maxECTS, currentECTS, averageGrade, courses } = studiesData;
const remainingECTS = maxECTS - currentECTS;
const progress = maxECTS > 0 ? ((currentECTS / maxECTS) * 100).toFixed(1) : 0;
const progressWidth = `${progress}%`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <MetaHead
      title={"Studies Dashboard"}
      description={"Elias Nowak's TU Wien Electrical Engineering and Information Technology study progress and completed coursework."}
      ogImageUrl={"/assets/images/profile.png"}
    />
  </head>

  <body>
    <Layout>
      <section class="py-16">
        <div class="mb-12">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue mb-3">TU Wien · BSc ETIT</p>
          <h1 class="text-5xl font-bold dark:text-light mb-4">Studies Dashboard</h1>
          <p class="dark:text-gray max-w-2xl">Progress in Electrical Engineering and Information Technology. Updated from the official transcript in August 2026.</p>
        </div>
        
        <!-- Stats Overview -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          <!-- Total ECTS Card -->
          <div class="bg-slate-50 dark:bg-[#202020] rounded-lg p-8 border border-slate-200 dark:border-slate-700">
            <p class="text-sm uppercase tracking-wide mb-2 dark:text-light opacity-60">Total ECTS</p>
            <p class="text-4xl font-bold dark:text-light">{currentECTS}<span class="text-2xl opacity-60">/{maxECTS}</span></p>
            <div class="mt-4 bg-slate-200 dark:bg-slate-700 rounded-full h-2 overflow-hidden">
              <div class="bg-blue-500 h-full rounded-full transition-all" style={{width: progressWidth}}></div>
            </div>
            <p class="text-sm mt-2 dark:text-light opacity-60">{progress}% Complete</p>
          </div>

          <!-- Average Grade Card -->
          <div class="bg-slate-50 dark:bg-[#202020] rounded-lg p-8 border border-slate-200 dark:border-slate-700">
            <p class="text-sm uppercase tracking-wide mb-2 dark:text-light opacity-60">Average Grade</p>
            <p class="text-4xl font-bold dark:text-light">{averageGrade}</p>
            <p class="text-sm mt-4 dark:text-light opacity-60">ECTS-weighted · 1 is best</p>
          </div>

          <!-- Remaining ECTS Card -->
          <div class="bg-slate-50 dark:bg-[#202020] rounded-lg p-8 border border-slate-200 dark:border-slate-700">
            <p class="text-sm uppercase tracking-wide mb-2 dark:text-light opacity-60">Remaining ECTS</p>
            <p class="text-4xl font-bold dark:text-light">{remainingECTS}</p>
            <p class="text-sm mt-4 dark:text-light opacity-60">To complete</p>
          </div>
        </div>

        <!-- Courses List -->
        <div class="w-full bg-slate-50 dark:bg-[#202020] rounded-lg border border-slate-200 dark:border-slate-700 overflow-hidden">
          <div class="px-4 py-4 border-b border-slate-200 dark:border-slate-700">
            <h2 class="text-xl font-semibold dark:text-light">Accomplished Courses</h2>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[48rem] table-fixed text-sm">
              <colgroup>
                <col />
                <col class="w-24" />
                <col class="w-24" />
                <col class="w-36" />
              </colgroup>
              <thead class="bg-slate-100 dark:bg-[#1a1a1a]">
                <tr>
                  <th class="text-left px-3 py-3 dark:text-light font-semibold">Course</th>
                  <th class="text-right px-3 py-3 dark:text-light font-semibold">Type</th>
                  <th class="text-right px-3 py-3 dark:text-light font-semibold">ECTS</th>
                  <th class="text-right px-3 py-3 dark:text-light font-semibold">Completed</th>
                </tr>
              </thead>
              <tbody>
                {courses.map((course, index) => (
                  <tr class={`border-t border-slate-200 dark:border-slate-700 ${index % 2 === 0 ? '' : 'bg-slate-50/50 dark:bg-[#181818]'}`}>
                    <td class="px-3 py-3 dark:text-light truncate" title={course.name}>{course.name}</td>
                    <td class="px-3 py-3 text-right dark:text-gray">{course.type}</td>
                    <td class="px-3 py-3 text-right dark:text-light">{course.ects}</td>
                    <td class="px-3 py-3 text-right dark:text-gray whitespace-nowrap">{course.date}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </Layout>
  </body>
</html>
